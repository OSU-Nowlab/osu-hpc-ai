-            and (get_moe_a2a_backend().is_deepep() or get_moe_a2a_backend().is_pplx())
+            and (get_moe_a2a_backend().is_deepep() or get_moe_a2a_backend().is_pplx()
+                 or get_moe_a2a_backend().is_nimble() or get_moe_a2a_backend().is_nccl_a2a())
             and not _is_npu
             and not _is_hip
         ):
