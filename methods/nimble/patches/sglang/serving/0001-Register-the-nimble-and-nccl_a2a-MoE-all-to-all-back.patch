             self._inners = [
                 PplxDispatcher(**kwargs) for _ in range(num_inner_dispatchers)
             ]
+        elif get_moe_a2a_backend().is_nimble() or get_moe_a2a_backend().is_nccl_a2a():
+            from nimble.integrations.sglang import NimbleEPDispatcher
